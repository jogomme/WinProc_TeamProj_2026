# 1. 기본 설정 (텍스트 파일 자동 감지)
* text=auto

# 2. C++ 소스 및 헤더 파일 (Windows 환경이므로 CRLF 고정)
*.cpp text eol=crlf
*.h text eol=crlf
*.hpp text eol=crlf
*.inl text eol=crlf

# 3. Windows 데스크톱/Win32 API 전용 파일
*.rc text eol=crlf
resource.h text eol=crlf
*.manifest text eol=crlf

# 4. Visual Studio 솔루션 및 프로젝트 파일 (CRLF 필수)
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# 5. Visual Studio 및 Win32 바이너리 자원 (절대 텍스트 변환 금지)
*.suo binary
*.user binary
*.aps binary
*.res binary
*.ico binary
*.bmp binary
*.cur binary

# 6. GitHub 언어 통계 설정 (C++ 프로젝트 강제 지정)
*.cpp linguist-language=C++
*.h linguist-language=C++
*.rc linguist-language=C++